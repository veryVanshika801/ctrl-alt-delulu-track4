diff --git a/scripts/evaluate_f1.cjs b/scripts/evaluate_f1.cjs
new file mode 100644
index 0000000..dcf8e79
--- /dev/null
+++ b/scripts/evaluate_f1.cjs
@@ -0,0 +1,110 @@
+'use strict';
+
+/**
+ * scripts/evaluate_f1.cjs
+ * Event-level precision / recall / F1 over the synthetic attack set AND the
+ * synthetic benign workload together, plus median time-to-alert and false
+ * alerts per 1,000 benign events.
+ *
+ * Usage: node scripts/evaluate_f1.cjs
+ *
+ * NOTE: both datasets are generated by this repo's own scripts, so these are
+ * regression numbers on our synthetic data, not a claim about real traffic.
+ */
+
+const fs = require('node:fs');
+const path = require('node:path');
+const { ExplainableDetector } = require('../lib/detector.cjs');
+const { generateAttackScenarios } = require('./evaluate_attack_set.cjs');
+const { generateBenignEvents } = require('./generate_benign_workload.cjs');
+
+const ALERT_RULES = new Set([
+  'RULE_UNAPPROVED_ROLE_CHANGE',
+  'RULE_REVIEW_AFTER_ROLE_CHANGE',
+  'RULE_LATERAL_MOVEMENT_TRAVERSAL',
+  'RULE_OUT_OF_SCOPE_ACCESS',
+  'RULE_EXCESSIVE_CLOCK_SKEW'
+]);
+
+function median(arr) {
+  if (!arr.length) return null;
+  const s = [...arr].sort((a, b) => a - b);
+  const m = Math.floor(s.length / 2);
+  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
+}
+
+function classify(detector, events) {
+  const res = detector.detect(events);
+  const byId = new Map(res.classifications.map(c => [c.event_id, c]));
+  return events.map(ev => {
+    const c = byId.get(ev.event_id);
+    return { ev, alerted: !!(c && ALERT_RULES.has(c.rule_id)) };
+  });
+}
+
+function main() {
+  let tp = 0, fp = 0, fn = 0, tn = 0;
+  const latencies = [];
+  const missed = [];
+
+  // 1) Attack set (contains attacks and benign look-alikes)
+  const atk = generateAttackScenarios();
+  const atkRows = classify(new ExplainableDetector(atk.approvalsData, atk.config), atk.events);
+  let atkFp = 0;
+  for (const { ev, alerted } of atkRows) {
+    const truth = atk.groundTruth.get(ev.event_id);
+    if (truth.isAttack && alerted) {
+      tp++;
+      const est = new Date(ev.event_time_utc).getTime() - (ev.source_clock_offset_ms || 0);
+      latencies.push(new Date(ev.received_time_utc).getTime() - est);
+    } else if (truth.isAttack) { fn++; missed.push(`${ev.event_id}:${truth.type}`); }
+    else if (alerted) { fp++; atkFp++; }
+    else tn++;
+  }
+
+  // 2) Benign workload (all events are negatives)
+  const N = 1000;
+  const benign = generateBenignEvents(N);
+  const benRows = classify(new ExplainableDetector({ synthetic: true, changes: [] }), benign);
+  const benFp = benRows.filter(r => r.alerted).length;
+  fp += benFp;
+  tn += benRows.length - benFp;
+
+  const precision = tp + fp ? tp / (tp + fp) : 0;
+  const recall = tp + fn ? tp / (tp + fn) : 0;
+  const f1 = precision + recall ? (2 * precision * recall) / (precision + recall) : 0;
+
+  const report = {
+    dataset: `synthetic attack set (${atk.events.length} events) + synthetic benign workload (${N} events)`,
+    note: 'Both datasets are generated by this repository; regression numbers, not real-traffic accuracy.',
+    true_positives: tp,
+    false_positives: fp,
+    false_negatives: fn,
+    true_negatives: tn,
+    precision: +precision.toFixed(4),
+    recall: +recall.toFixed(4),
+    f1: +f1.toFixed(4),
+    false_alerts_on_attack_set_benign_lookalikes: atkFp,
+    false_alerts_per_1000_benign_events: +(benFp * 1000 / N).toFixed(2),
+    median_time_to_alert_ms: median(latencies),
+    missed_attack_events: missed
+  };
+
+  console.log('==================================================');
+  console.log('F1 EVALUATION (attack set + benign workload)');
+  console.log('==================================================');
+  console.log(`TP=${tp}  FP=${fp}  FN=${fn}  TN=${tn}`);
+  console.log(`Precision: ${report.precision}`);
+  console.log(`Recall:    ${report.recall}`);
+  console.log(`F1:        ${report.f1}`);
+  console.log(`False alerts per 1,000 benign events: ${report.false_alerts_per_1000_benign_events}`);
+  console.log(`Median time to alert: ${report.median_time_to_alert_ms} ms`);
+  if (missed.length) console.log(`Missed: ${missed.join(', ')}`);
+  console.log('(Synthetic data generated by this repo; not real-traffic accuracy.)');
+
+  const dir = path.join(__dirname, '..', 'docs', 'results');
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, 'f1_evaluation_results.json'), JSON.stringify(report, null, 2), 'utf8');
+}
+
+main();
