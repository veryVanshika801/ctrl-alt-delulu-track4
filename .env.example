# Track 4 Environment Configuration
# Copy this file to .env and fill in the values

# Directory where cryptographic keys and audit logs are stored
TRACK4_STATE_DIR=./state

# Enable live lockout for repeated denied access attempts (0 = disabled, 1 = enabled)
TRACK4_LIVE_LOCKOUT=0

# Maximum allowed clock skew between nodes in milliseconds
MAX_CLOCK_SKEW_MS=5000

.env
.gitignore
